# ATChess web service.
#
# THIS FILE IS THE TRUTH; deploy/scripts/check-unit-drift.sh enforces it. See
# atchess-protocol.service for why the deploy detects drift rather than
# installing over it.
#
# Reconciled 2026-08-30 from what was actually running. This service writes
# nothing, so the log directory is the only path it needs.

[Unit]
Description=ATChess Web Service
After=network.target

[Service]
Type=simple
User=atchess
Group=atchess
WorkingDirectory=/srv/atchess/app
ExecStart=/srv/atchess/app/bin/atchess-web
Environment="ATCHESS_STATIC_DIR=/srv/atchess/app/web/static"
Restart=always
RestartSec=10
StandardOutput=append:/var/log/atchess/web.log
StandardError=append:/var/log/atchess/web-error.log
EnvironmentFile=/etc/atchess/web.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/atchess
ReadOnlyPaths=/etc/atchess/keys

[Install]
WantedBy=multi-user.target
